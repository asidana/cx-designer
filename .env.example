# Canvas (required)
# The canvas feature needs no environment variables — it runs fully client-side.

# Optional FastAPI backend (server/)
# Set these only when running/deploying the optional persistence service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_cx
REDIS_URL=redis://localhost:6379

# Model providers used by the optional backend / live adapters.
# The canvas simulator works without any keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
